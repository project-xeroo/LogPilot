# ---------------------------------------------------------------------------------------------
# LogPilot AI Agent - configuration. Copy to .env (never commit real values).
# All settings are read from the environment by every service (12-factor).
# ---------------------------------------------------------------------------------------------

ENVIRONMENT=dev                # dev | staging | prod
LOG_LEVEL=INFO
SEED_DEMO=true                 # create demo users + project on first start (set false in real deployments)
# Demo accounts (dev only): admin@, sre@, dev@, junior@, viewer@ logpilot.local  - password below
SEED_DEMO_PASSWORD=logpilot-demo
# BOOTSTRAP_ADMIN_EMAIL=you@company.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# --- host ports (override when 5432/6379/8000... are already taken on your machine) -----------
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
S3_PORT=8333
GATEWAY_PORT=8000
CONSOLE_PORT=8080

# --- secrets: CHANGE THESE ------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60
INTERNAL_API_TOKEN=internal-change-me
S3_ACCESS_KEY=logpilot
S3_SECRET_KEY=logpilot-secret
S3_BUCKET=logpilot-logs

# --- cloud AI provider (PRD Section 6) --------------------------------------------------------
# mock               deterministic offline provider: no API key, no network. Great for demos and CI.
# openai_compatible  any OpenAI-compatible REST endpoint (also the interface used for IBM Bob)
AI_PROVIDER=mock
AI_BASE_URL=                   # e.g. https://<your-provider-host>/v1
AI_API_KEY=
AI_FAST_MODEL=fast             # chat, search responses, log explanations, classification
AI_DEEP_MODEL=deep             # RCA, reports, pre-mortems, executive summaries, risk explanation
AI_EMBEDDING_MODEL=embed       # embeddings, semantic search, clustering, forecasting similarity
EMBEDDING_DIM=256              # MUST equal the embedding model's output size (256 for the mock provider)
# Outbound calls are restricted to these hosts (default: the host of AI_BASE_URL only)
AI_EGRESS_ALLOWLIST=

# --- forecasting (PRD 4.2) --------------------------------------------------------------------
FORECAST_INTERVAL_SECONDS=60
FORECAST_WARNING_THRESHOLD=60
FORECAST_CRITICAL_THRESHOLD=80
FORECAST_CLOCK=wall            # wall = real time | data = newest ingested record (replay/backtests)

# --- notifications ----------------------------------------------------------------------------
WEBHOOK_ALLOW_PRIVATE=false    # true only in dev: allow webhooks to private addresses
